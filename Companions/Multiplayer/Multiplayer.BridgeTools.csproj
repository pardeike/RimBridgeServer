<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <AssemblyName>Multiplayer.BridgeTools</AssemblyName>
    <RootNamespace>RimBridgeServer.MultiplayerTools</RootNamespace>
    <OutputPath>../../artifacts/BridgeTools/Multiplayer/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>$(ModVersion)</Version>
    <DebugType>None</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="RimBridgeServer.Sdk" Version="$(RimBridgeServerSdkVersion)" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4990-unstable" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
