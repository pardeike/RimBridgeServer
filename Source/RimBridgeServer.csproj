<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<RootNamespace>$(ModFileName)</RootNamespace>
		<AssemblyName>$(ModFileName)</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<OutputPath>..\1.7\Assemblies\</OutputPath>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<Version>$(ModVersion)</Version>
		<AssemblyVersion>$(ModVersion)</AssemblyVersion>
		<FileVersion>$(ModVersion)</FileVersion>
		<PackageVersion>$(ModVersion)</PackageVersion>
		<InformationalVersion>$(ModVersion)</InformationalVersion>
		<Company>Brrainz</Company>
		<Authors>Andreas Pardeike</Authors>
		<Copyright>Copyright Andreas Pardeike</Copyright>
		<PackageProjectUrl>$(Repository)</PackageProjectUrl>
		<RepositoryUrl>$(Repository)</RepositoryUrl>
		<Product>$(ModName)</Product>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <BuildWaylithTools Condition="'$(BuildWaylithTools)' == ''">false</BuildWaylithTools>
        <PythonCommand Condition="'$(PythonCommand)' == ''">python3</PythonCommand>
        <GlobalBridgeToolsDir Condition="'$(RIMWORLD_MOD_DIR)' != ''">$([MSBuild]::NormalizeDirectory('$(RIMWORLD_MOD_DIR)\..\BridgeTools'))</GlobalBridgeToolsDir>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<DebugType>none</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugSymbols>true</DebugSymbols>
		<DefineConstants>TRACE;DEBUG</DefineConstants>
		<Optimize>false</Optimize>
		<DebugType>embedded</DebugType>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="..\Directory.Build.props">
			<Link>%(Filename)%(Extension)</Link>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<Compile Remove="RimBridgeServer.Core\**\*.cs" />
		<Compile Remove="RimBridgeServer.Contracts\**\*.cs" />
		<Compile Remove="RimBridgeServer.Extensions.Abstractions\**\*.cs" />
		<Compile Remove="RimBridgeServer.Sdk\**\*.cs" />
		<None Include="RimBridgeServer.Core\**\*" />
		<None Include="RimBridgeServer.Contracts\**\*" />
		<None Include="RimBridgeServer.Extensions.Abstractions\**\*" />
		<None Include="RimBridgeServer.Sdk\**\*" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Companions\Multiplayer\Multiplayer.BridgeTools.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\Companions\Waylith\Waylith.BridgeTools.csproj" ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true" Condition="'$(BuildWaylithTools)' == 'true'" />
		<ProjectReference Include="RimBridgeServer.Core\RimBridgeServer.Core.csproj" />
		<ProjectReference Include="RimBridgeServer.Contracts\RimBridgeServer.Contracts.csproj" />
		<ProjectReference Include="RimBridgeServer.Extensions.Abstractions\RimBridgeServer.Extensions.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4990-unstable" GeneratePathProperty="true" />
		<PackageReference Include="Lib.GAB" Version="$(LibGabPackageVersion)" />
		<PackageReference Include="RimBridgeServer.Sdk" Version="$(RimBridgeServerSdkVersion)" />
		<PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.5" ExcludeAssets="runtime" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="TaskPubliciser" Version="1.0.3" PrivateAssets="all" ExcludeAssets="runtime" />
	</ItemGroup>

	<Target Name="MyCode" BeforeTargets="ResolveAssemblyReferences">
		<PropertyGroup>
			<AssemblyCSharp>$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll</AssemblyCSharp>
			<PubliciseOutputPath>$(MSBuildProjectDirectory)/obj/publicised/</PubliciseOutputPath>
			<AssemblyCSharp_Publicised>$(PubliciseOutputPath)Assembly-CSharp_publicised.dll</AssemblyCSharp_Publicised>
		</PropertyGroup>
		<MakeDir Directories="$(PubliciseOutputPath)" />
		<Publicise TargetAssemblyPath="$(AssemblyCSharp)" OutputPath="$(PubliciseOutputPath)" Condition="Exists('$(AssemblyCSharp)')" />
		<Message Importance="High" Text="Replacing reference to un-publicised assemblies with publicised equivalents ..." />
		<ItemGroup>
			<Reference Include="$(AssemblyCSharp_Publicised)">
				<SpecificVersion>false</SpecificVersion>
				<HintPath>$(AssemblyCSharp_Publicised)</HintPath>
				<Implicit>true</Implicit>
				<Private>false</Private>
			</Reference>
		</ItemGroup>
	</Target>

	<Target Name="UpdateReferences" AfterTargets="ResolveLockFileReferences">
		<Message Importance="High" Text="Remove References ..." />
		<ItemGroup>
			<Reference Remove="$(PkgKrafs_Rimworld_Ref)\ref\net10.0\Assembly-CSharp.dll" />
		</ItemGroup>
	</Target>

	<PropertyGroup>
		<RimWorldModDeployDir Condition="'$(RIMWORLD_MOD_TARGET_DIR)' != ''">$(RIMWORLD_MOD_TARGET_DIR)</RimWorldModDeployDir>
		<RimWorldModDeployDir Condition="'$(RimWorldModDeployDir)' == '' And '$(RIMWORLD_MOD_DIR)' != ''">$(RIMWORLD_MOD_DIR)\$(ModFileName)</RimWorldModDeployDir>
		<RimWorldModZipPath Condition="'$(RIMWORLD_MOD_ZIP_PATH)' != ''">$(RIMWORLD_MOD_ZIP_PATH)</RimWorldModZipPath>
		<RimWorldModZipPath Condition="'$(RimWorldModZipPath)' == '' And '$(RIMWORLD_MOD_TARGET_DIR)' != ''">$(RIMWORLD_MOD_TARGET_DIR).zip</RimWorldModZipPath>
		<RimWorldModZipPath Condition="'$(RimWorldModZipPath)' == '' And '$(RIMWORLD_MOD_DIR)' != ''">$(RIMWORLD_MOD_DIR)\$(ModFileName).zip</RimWorldModZipPath>
	</PropertyGroup>


  <Target Name="ValidatePortInputs" BeforeTargets="PrepareForBuild">
    <PropertyGroup>
      <ExpectedOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '../1.7/Assemblies/'))</ExpectedOutputDirectory>
      <CurrentOutputDirectory>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(OutputPath)'))</CurrentOutputDirectory>
      <CurrentTargetDirectory>$([MSBuild]::NormalizeDirectory('$(TargetDir)'))</CurrentTargetDirectory>
    </PropertyGroup>
    <Error Condition="'$(CurrentOutputDirectory)' != '$(ExpectedOutputDirectory)' Or '$(CurrentTargetDirectory)' != '$(ExpectedOutputDirectory)'" Text="Active build output must remain in 1.7/Assemblies. The published 1.6 payload is frozen." />
    <Error Condition="'$(PlatformTarget)' != 'AnyCPU'" Text="The active RimWorld 1.7 bridge must target AnyCPU." />
    <Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; validate-source" />
    <Exec Condition="'$(RimWorldModDeployDir)' != ''" Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; check --mods-dir &quot;$(RIMWORLD_MOD_DIR)&quot; --target-dir &quot;$(RimWorldModDeployDir)&quot; --zip-path &quot;$(RimWorldModZipPath)&quot; --waylith $(BuildWaylithTools)" />
  </Target>
  <Target Name="PostBuildAction" AfterTargets="Build">
    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)/../About/About.xml" Query="//ModMetaData/modVersion" Value="$(ModVersion)" />
    <XmlPoke XmlInputPath="$(MSBuildProjectDirectory)/../About/Manifest.xml" Query="//Manifest/version" Value="$(ModVersion)" />
    <Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; package" />
  </Target>
  <Target Name="CopyToRimworld" AfterTargets="PostBuildAction" Condition="'$(RimWorldModDeployDir)' != ''">
    <Exec Command="&quot;$(PythonCommand)&quot; &quot;$(MSBuildProjectDirectory)/../scripts/rimworld_deploy_guard.py&quot; deploy --mods-dir &quot;$(RIMWORLD_MOD_DIR)&quot; --target-dir &quot;$(RimWorldModDeployDir)&quot; --zip-path &quot;$(RimWorldModZipPath)&quot; --waylith $(BuildWaylithTools)" />
  </Target>
</Project>
